rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roleName) {
      return hasUserProfile() && (
        (currentUser().data.get('role', []) is list && roleName in currentUser().data.get('role', [])) ||
        (currentUser().data.get('role', '') is string && currentUser().data.get('role', '') == roleName)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isGuru() {
      return hasRole('guru');
    }

    function isStaff() {
      return isAdmin() || isGuru();
    }

    function guruOwnsQuestion(data) {
      return isGuru()
        && currentUser().data.get('mapel', []) is list
        && data.mataPelajaran is string
        && data.mataPelajaran in currentUser().data.get('mapel', [])
        && currentUser().data.get('kelas', []) is list
        && (
          (data.kelas is list && data.kelas.hasAny(currentUser().data.get('kelas', [])))
          ||
          (data.kelas is string && data.kelas in currentUser().data.get('kelas', []))
          ||
          (data.kelas is list && 'Umum' in data.kelas)
        );
    }

    function canManageQuestion(data) {
      return isAdmin() || guruOwnsQuestion(data);
    }

    match /pengaturan/{docId} {
      allow read: if signedIn() && docId in ['status_registrasi', 'data_akademik'];
      allow read: if isStaff() && docId in ['waktu_ujian', 'jadwal_ujian', 'acak_soal', 'token_ujian'];
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if
        (signedIn() && request.auth.uid == uid && request.resource.data.role is list && request.resource.data.username is string && request.resource.data.nama is string)
        ||
        (isAdmin() && request.resource.data.role is list && request.resource.data.username is string && request.resource.data.nama is string);
      allow update: if
        isAdmin()
        ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'username', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create: if canManageQuestion(request.resource.data);
      allow update: if canManageQuestion(resource.data) && canManageQuestion(request.resource.data);
      allow delete: if canManageQuestion(resource.data);
    }

    match /hasil_ujian/{hasilId} {
      allow create: if false;
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;
      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}