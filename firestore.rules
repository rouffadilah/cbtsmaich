rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && currentUser().exists();
    }

    // Profil pengguna pada project ini menyimpan role sebagai array/list.
    // Tetap dukung format lama berupa string.
    function isAdmin() {
      return hasUserProfile() && (
        (currentUser().data.role is list && currentUser().data.role.hasAny(['admin'])) ||
        (currentUser().data.role is string && currentUser().data.role == 'admin')
      ) || (
        signedIn() && request.auth.uid == 'fI5m4g8OOYZKfPnrHVExopyyYr2'
      );
    }

    function isGuru() {
      return hasUserProfile() && (
        (currentUser().data.role is list && currentUser().data.role.hasAny(['guru'])) ||
        (currentUser().data.role is string && currentUser().data.role == 'guru')
      );
    }

    function isStaff() {
      return isAdmin() || isGuru();
    }

    match /pengaturan/{docId} {
      allow read: if docId in ['status_registrasi', 'data_akademik'];
      allow read: if isStaff() && docId in [
        'waktu_ujian',
        'jadwal_ujian',
        'acak_soal',
        'token_ujian'
      ];
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow create: if
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        )
        ||
        (
          isAdmin() &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        );

      allow update: if
        isAdmin()
        ||
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nama', 'username', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;
      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /hasil_ujian/{hasilId} {
      allow create: if false;
      allow read: if isStaff() || (
        signedIn() && resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
