rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTH / ROLE HELPERS
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    // Selalu membaca profil milik user yang sedang login.
    // Match /users/{uid} mengizinkan self-read, sehingga helper ini
    // tidak bergantung pada hak baca akun lain.
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && currentUser().exists();
    }

    function hasRole(roleName) {
      return hasUserProfile() && (
        (currentUser().data.role is list && roleName in currentUser().data.role) ||
        (currentUser().data.role is string && currentUser().data.role == roleName)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isGuru() {
      return hasRole('guru');
    }

    function isStaff() {
      return isAdmin() || isGuru();
    }

    // =========================
    // PENGATURAN
    // =========================
    match /pengaturan/{docId} {
      // Data yang diperlukan login/dashboard.
      allow read: if signedIn() && docId in [
        'status_registrasi',
        'data_akademik'
      ];

      // Konfigurasi ujian untuk guru/admin.
      allow read: if isStaff() && docId in [
        'waktu_ujian',
        'jadwal_ujian',
        'acak_soal',
        'token_ujian'
      ];

      allow write: if isAdmin();
    }

    // =========================
    // USERS
    // =========================
    match /users/{uid} {
      // Self-read selalu boleh. Admin boleh membaca seluruh daftar pengguna.
      allow read: if signedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow create: if
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        )
        ||
        (
          isAdmin() &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        );

      allow update: if
        isAdmin()
        ||
        (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nama', 'username', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // =========================
    // BANK SOAL
    // =========================
    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // =========================
    // HASIL UJIAN
    // =========================
    match /hasil_ujian/{hasilId} {
      // Browser tidak boleh membuat hasil secara langsung.
      allow create: if false;

      // Dashboard guru/admin membutuhkan query seluruh hasil ujian.
      // Siswa hanya dapat membaca hasil miliknya sendiri.
      allow read: if isStaff();
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================
    // ATTEMPTS / ANSWERS
    // =========================
    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;

      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // =========================
    // AUDIT LOGS
    // =========================
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
