rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / ROLE
    // =========================================================
    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    // Role pada project CBT-SMAICH disimpan sebagai ARRAY,
    // contoh: ["siswa", "guru", "admin"].
    // Tetap dukung string untuk data lama.
    function hasRole(roleName) {
      return userProfileExists() && (
        (
          currentUser().data.role is list &&
          roleName in currentUser().data.role
        ) ||
        (
          currentUser().data.role is string &&
          currentUser().data.role == roleName
        )
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isGuru() {
      return hasRole('guru');
    }

    function isStaff() {
      return isAdmin() || isGuru();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================================================
    // PENGATURAN
    // =========================================================
    match /pengaturan/{docId} {
      allow read: if signedIn() && docId in [
        'status_registrasi',
        'data_akademik'
      ];

      allow read: if isStaff() && docId in [
        'waktu_ujian',
        'jadwal_ujian',
        'acak_soal',
        'token_ujian'
      ];

      allow write: if isAdmin();
    }

    // =========================================================
    // USERS
    // =========================================================
    match /users/{uid} {
      // Admin dapat membaca seluruh pengguna untuk dashboard.
      // Pengguna biasa hanya dapat membaca dokumennya sendiri.
      allow read: if isAdmin() || isSelf(uid);

      allow create: if
        (
          isSelf(uid) &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        ) ||
        (
          isAdmin() &&
          request.resource.data.role is list &&
          request.resource.data.username is string &&
          request.resource.data.nama is string
        );

      allow update: if
        isAdmin() ||
        (
          isSelf(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nama',
            'username',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // BANK SOAL
    // =========================================================
    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // =========================================================
    // HASIL UJIAN
    // =========================================================
    // Dashboard guru/admin membaca koleksi hasil ujian secara agregat.
    // Siswa hanya dapat membaca hasil miliknya sendiri.
    match /hasil_ujian/{hasilId} {
      allow read: if isStaff() || (
        signedIn() && resource.data.uid == request.auth.uid
      );

      // Hasil ujian dibuat oleh backend/server, bukan browser.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // ATTEMPTS
    // =========================================================
    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;

      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // =========================================================
    // AUDIT LOG
    // =========================================================
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
