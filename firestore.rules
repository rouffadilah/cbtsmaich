rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // AUTHENTICATION
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserProfile() {
      return signedIn() && currentUser().exists();
    }

    function isAdmin() {
      return hasUserProfile()
        && 'admin' in currentUser().data.role;
    }

    function isGuru() {
      return hasUserProfile()
        && 'guru' in currentUser().data.role;
    }

    function isStaff() {
      return isAdmin() || isGuru();
    }


    // ==============================
    // PENGATURAN
    // ==============================

    match /pengaturan/{docId} {

      // Konfigurasi publik yang diperlukan halaman login/dashboard
      allow read: if docId in [
        'status_registrasi',
        'data_akademik'
      ];

      // Semua pengaturan lain hanya admin
      allow read, write: if isAdmin();
    }


    // ==============================
    // USERS
    // ==============================

    match /users/{uid} {

      // User boleh melihat profil sendiri.
      // Admin boleh melihat semua user.
      allow read: if isSelf(uid) || isAdmin();

      // Registrasi siswa/guru
      allow create: if
        (
          isSelf(uid)
          &&
          request.resource.data.role is list
          &&
          request.resource.data.username is string
          &&
          request.resource.data.nama is string
        )
        ||
        (
          isAdmin()
          &&
          request.resource.data.role is list
          &&
          request.resource.data.username is string
          &&
          request.resource.data.nama is string
        );

      // Admin bebas mengubah user.
      // User biasa hanya boleh mengubah data profil tertentu.
      allow update: if
        isAdmin()
        ||
        (
          isSelf(uid)
          &&
          request.resource.data.role == resource.data.role
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'nama',
              'username',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }


    // ==============================
    // BANK SOAL
    // ==============================

    match /bank_soal/{soalId} {

      // Guru dan admin dapat membaca soal
      allow read: if isStaff();

      // Guru dan admin dapat mengelola soal
      allow create, update, delete: if isStaff();
    }


    // ==============================
    // EXAM ATTEMPTS
    // ==============================

    match /exam_attempts/{attemptId} {

      // Guru/admin dapat melihat attempt
      allow read: if isStaff();

      // Tidak boleh ditulis langsung oleh browser
      allow write: if false;

      match /answers/{answerId} {

        allow read: if isStaff();

        // Jawaban harus ditulis melalui backend/server
        allow write: if false;
      }
    }


    // ==============================
    // HASIL UJIAN
    // ==============================

    match /hasil_ujian/{hasilId} {

      // Hasil dibuat oleh backend
      allow create: if false;

      // Guru/admin boleh membaca semua hasil.
      // Siswa hanya boleh membaca hasil miliknya.
      allow read: if
        isStaff()
        ||
        (
          signedIn()
          &&
          resource.data.uid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }


    // ==============================
    // AUDIT LOG
    // ==============================

    match /audit_logs/{logId} {

      allow read, write: if isAdmin();
    }
  }
}
