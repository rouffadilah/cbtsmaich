rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function roles() {
      return signedIn() && userDoc(request.auth.uid).exists()
        ? userDoc(request.auth.uid).data.role
        : [];
    }

    function hasRole(role) {
      return signedIn() && role in roles();
    }

    // Emergency dashboard-admin fallback for the currently verified admin account.
    // Normal users still use the role stored in users/{uid}.
    function isDashboardAdmin() {
      return signedIn() && request.auth.uid == 'fI5m4g8OOYZKfPnrHVExopyyYr2';
    }

    function isAdmin() { return hasRole('admin') || isDashboardAdmin(); }
    function isStaff() { return isAdmin() || hasRole('guru'); }

    match /pengaturan/{docId} {
      allow read: if docId in ['status_registrasi', 'data_akademik'];

      allow read, write: if isStaff() && docId in [
        'waktu_ujian',
        'jadwal_ujian',
        'acak_soal',
        'token_ujian'
      ];

      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if (
        isSelf(uid) &&
        (request.resource.data.role == ['siswa'] || request.resource.data.role == ['guru']) &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      ) || (
        isAdmin() &&
        request.resource.data.role is list &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      );
      allow update: if isAdmin() || (
        isSelf(uid) &&
        resource.data.role == request.resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'username', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;
      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /hasil_ujian/{hasilId} {
      allow create: if false;
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
