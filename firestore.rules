rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function roles() {
      return signedIn() && userDoc(request.auth.uid).exists()
        ? userDoc(request.auth.uid).data.role
        : [];
    }

    function hasRole(role) {
      return signedIn() && role in roles();
    }

    function isAdmin() { return hasRole('admin'); }
    function isStaff() { return isAdmin() || hasRole('guru'); }

    match /pengaturan/{docId} {
      allow read: if docId in ['status_registrasi', 'data_akademik'];
      // Token configuration is server-owned. Dashboard uses /api/token-* with Admin SDK.
      allow read, write: if false;
      // Other exam configuration remains admin-only.
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if (
        isSelf(uid) &&
        (request.resource.data.role == ['siswa'] || request.resource.data.role == ['guru']) &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      ) || (
        isAdmin() &&
        request.resource.data.role is list &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      );
      allow update: if isAdmin() || (
        isSelf(uid) &&
        resource.data.role == request.resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'username', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /bank_soal/{soalId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // Attempts and answers are authoritative server records. No browser/client may write them directly.
    match /exam_attempts/{attemptId} {
      allow read: if isStaff();
      allow write: if false;
      match /answers/{answerId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /hasil_ujian/{hasilId} {
      allow create: if false;
      allow read: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
