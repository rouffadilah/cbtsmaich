rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasRole(role) {
      return signedIn() &&
        role in userDoc(request.auth.uid).data.role;
    }

    function isAdmin() { return hasRole('admin'); }
    function isStaff() { return isAdmin() || hasRole('guru'); }
    function isStudent() { return hasRole('siswa'); }

    // Pengaturan yang dipakai dashboard/login.
    // Guru/admin boleh membaca konfigurasi ujian agar dashboard dapat dimuat.
    // Penulisan pengaturan ujian boleh dilakukan guru/admin; konfigurasi akademik/registrasi
    // tetap hanya dapat diubah admin.
    match /pengaturan/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin() ||
        (isStaff() && docId in ['waktu_ujian', 'jadwal_ujian', 'token_ujian', 'acak_soal']);
    }

    // Profil pengguna.
    // Guru/admin perlu membaca daftar pengguna untuk statistik/dashboard.
    // Perubahan data pengguna tetap dikendalikan admin, kecuali pengguna mengubah profilnya sendiri.
    match /users/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if (
        isSelf(uid) &&
        (request.resource.data.role == ['siswa'] || request.resource.data.role == ['guru']) &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      ) || (
        isAdmin() &&
        request.resource.data.role is list &&
        request.resource.data.username is string &&
        request.resource.data.nama is string
      );
      allow update: if isAdmin() || (
        isSelf(uid) &&
        resource.data.role == request.resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'username', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Bank soal: siswa/staf terautentikasi boleh membaca. Hanya admin/guru yang menulis.
    match /bank_soal/{soalId} {
      allow read: if signedIn() && (isStaff() || isStudent());
      allow create, update, delete: if isStaff();
    }

    // Hasil ujian: siswa hanya boleh membuat hasil untuk UID sendiri dan membaca hasilnya sendiri.
    // Guru/admin boleh membaca hasil untuk statistik dashboard.
    match /hasil_ujian/{hasilId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() &&
        (isStaff() || resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
